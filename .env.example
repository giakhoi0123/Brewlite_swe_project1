POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5434
DATABASE_URL=postgresql://brewlite:change_me_local@localhost:5434/brewlite?schema=public
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3002
PORT=3001
BARISTA_EMAIL=barista@example.test
BARISTA_PASSWORD=SetStrongPassword123
BARISTA_NAME="Nhân viên pha chế"
# VNPAY WebPay 2.1.0 (TEST). Không commit TmnCode/HashSecret thật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# IPv4 công khai mà backend dùng để gọi QueryDR; không dùng loopback/private IP.
VNPAY_QUERY_IP_ADDRESS=
VNPAY_RETURN_URL=http://localhost:3001/api/payments/vnpay/return
# Để trống cho VNPAY hiển thị các phương thức merchant được cấp.
# Chỉ đặt VNPAYQR sau khi VNPAY xác nhận terminal TEST đã bật kênh QR.
VNPAY_BANK_CODE=
VNPAY_EXPIRE_MINUTES=15
FRONTEND_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_DATA_MODE=api
# SMTP / Email Configuration (Mailpit in dev/test, Real SMTP in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@brewlite.vn
SMTP_SECURE=false
