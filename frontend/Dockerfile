FROM node:24-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_DATA_MODE=mock
ARG NEXT_PUBLIC_API_URL=http://localhost:3001/api
ARG NEXT_PUBLIC_PAYMENT_DEMO_CONTROLS=false
ENV NEXT_PUBLIC_DATA_MODE=$NEXT_PUBLIC_DATA_MODE
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PAYMENT_DEMO_CONTROLS=$NEXT_PUBLIC_PAYMENT_DEMO_CONTROLS
RUN npm run build
EXPOSE 3000
CMD ["npm", "run", "start"]
