{
  "info": {
    "_postman_id": "a9000009-0000-4000-8000-000000000009",
    "name": "BrewLite - Performance Load Test",
    "description": "Collection chuyen dung de chay Postman Performance Runner / Newman load test (khong chua negative 4xx test de Error Rate = 0%). Kiem tra NFR phan hoi < 500ms tren cac luong Auth, Products, Cart, Orders (co cancel hoan kho), Loyalty va Promotions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "customerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerPassword",
      "value": "Password123",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "31a650c7-8597-4a01-a8e2-000000000001",
      "type": "string"
    },
    {
      "key": "toppingId",
      "value": "b4151b67-4044-43ce-9cac-000000000001",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(pm.request.method)) {",
          "  pm.request.headers.upsert({ key: 'Origin', value: pm.collectionVariables.get('frontendOrigin') || 'http://localhost:3000' });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is below 500ms (NFR)', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01. Register Customer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const uniqueEmail = 'perf-' + Date.now() + '-' + Math.floor(Math.random() * 1000000000) + '@brewlite.local';",
              "pm.collectionVariables.set('customerEmail', uniqueEmail);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Perf Tester\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
