      "name": "07 VNPAY Sandbox - thao tác thủ công",
      "item": [
        {
          "name": "01 Tạo giao dịch VNPAY",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/payments",
            "description": "Dùng Order mới chưa có Payment đang xử lý. Mở paymentUrl trong trình duyệt và thanh toán bằng phương tiện TEST.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"method\": \"VNPAY_QR\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if(pm.response.code === 201) {const p=pm.response.json(); pm.collectionVariables.set('paymentId',p.id); if(p.paymentUrl) pm.collectionVariables.set('paymentUrl',p.paymentUrl); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Đối soát QueryDR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{baseUrl}}/payments/{{orderId}}/reconcile",
            "description": "Cần cấu hình QueryDR và IP egress. Có thể vẫn PROCESSING khi gateway chưa chốt; không tạo attempt song song."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 IPN chữ ký sai - negative",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{baseUrl}}/payments/vnpay/ipn?vnp_SecureHash=invalid",
            "description": "Callback GET dùng query, không JSON body. Kỳ vọng RspCode 97, DB không đổi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if(pm.response.code === 200) pm.test('Từ chối checksum sai',()=>pm.expect(pm.response.json().RspCode).to.eql('97'));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Return chữ ký sai - negative",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{baseUrl}}/payments/vnpay/return?vnp_SecureHash=invalid",
            "description": "Tắt Automatically follow redirects trong request Settings để quan sát 302. Return không ghi kết quả vào DB."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 302', () => pm.response.to.have.status(302));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
