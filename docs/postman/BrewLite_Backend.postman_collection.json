            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const p = pm.response.json(); const s = p.sizes.find(x => x.available && x.id === p.defaultSizeId) || p.sizes.find(x => x.available); pm.test('Có size khả dụng', () => pm.expect(s).to.exist); if(s) { pm.collectionVariables.set('size', s.code); pm.collectionVariables.set('productSizeId', s.id); } const t = p.toppings.find(x => x.available); if(t) pm.collectionVariables.set('toppingId', t.id); }"
                ]
